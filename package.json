{
	"name": "todosh",
	"version": "1.0.1",
	"description": "A fast, keyboard-driven Kanban task manager for the terminal",
	"author": "Alexandru Spinu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/alexspinu/todosh"
	},
	"keywords": [
		"todo",
		"kanban",
		"cli",
		"tui",
		"terminal",
		"task-manager"
	],
	"type": "module",
	"bin": {
		"todosh": "./bin/todosh.ts"
	},
	"scripts": {
		"check": "biome check",
		"dev": "bun run index.tsx --watch",
		"format": "biome format",
		"lint": "biome lint",
		"start": "bun run index.tsx",
		"build": "bun run build.ts"
	},
	"dependencies": {
		"@opentui/core": "0.5.1",
		"@opentui/keymap": "0.5.1",
		"@opentui/react": "0.5.1",
		"react": "^19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.18",
		"@types/ws": "^8.18.1",
		"react-devtools-core": "^7.0.1",
		"ws": "^8.18.0"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	}
}
