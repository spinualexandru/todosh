{
	"name": "todosh",
	"version": "1.0.2",
	"description": "A fast, keyboard-driven Kanban task manager for the terminal",
	"author": "Alexandru Spinu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/alexspinu/todosh"
	},
	"keywords": [
		"todo",
		"kanban",
		"cli",
		"tui",
		"terminal",
		"task-manager"
	],
	"type": "module",
	"bin": {
		"todosh": "./bin/todosh.ts"
	},
	"scripts": {
		"check": "bun run lint && bun run format:check",
		"dev": "bun run index.tsx --watch",
		"format": "oxfmt --write .",
		"lint": "oxlint --deny-warnings .",
		"start": "bun run index.tsx",
		"build": "bun run build.ts",
		"format:check": "oxfmt --check .",
		"lint:fix": "oxlint --fix .",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@linear/sdk": "^95.1.0",
		"@opentui/core": "0.5.11",
		"@opentui/keymap": "0.5.11",
		"@opentui/react": "0.5.11",
		"@xstate/react": "^6.1.0",
		"react": "^19.3.0",
		"xstate": "^5.33.2"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/react": "^19.3.0",
		"@types/ws": "^8.18.1",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"react-devtools-core": "^8.0.0",
		"ws": "^8.21.3"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	}
}
